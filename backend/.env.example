# ---------------------------------------------------------------------------
# Split Inference Control Plane -- copy to .env and edit
# ---------------------------------------------------------------------------

# Single API token stub. The UI sends it as `Authorization: Bearer <token>`
# and on the WebSocket as `?token=<token>`.
API_TOKEN=dev-token-change-me

# Pre-fill the token in /docs so you never click Authorize. Applied only to
# requests coming from loopback, so `--host 0.0.0.0` will not hand the token to
# remote visitors. Set false if you'd rather always authorize by hand.
DOCS_AUTOFILL_TOKEN=true

# Same rule for the UI served at `/`: a local browser gets the token handed to
# it in runtime-config.js and is live immediately; a remote one is asked to
# paste it into the header's connection chip. Set false to always ask.
WEB_AUTOFILL_TOKEN=true

# Comma-separated allowed browser origins for the UI. Use * only for local dev.
# The bundled HTML opened from disk sends Origin: null -- add it explicitly.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,null

# SQLite (async driver). Path is relative to the backend/ directory.
DATABASE_URL=sqlite+aiosqlite:///./split_inference.db

# RabbitMQ, as reachable FROM THIS SERVICE.
BROKER_URL=amqp://guest:guest@localhost:5672/

# RabbitMQ, as reachable FROM THE DEVICES. Usually the same broker on a routable
# host/IP rather than localhost. Leave blank to reuse BROKER_URL.
DEVICE_BROKER_URL=

# RabbitMQ HTTP management API -- used to read queue depth. Blank disables the
# queue_depth metric (it then falls back to a passive queue declare).
RABBITMQ_MGMT_URL=http://localhost:15672
RABBITMQ_MGMT_USER=guest
RABBITMQ_MGMT_PASSWORD=guest
RABBITMQ_VHOST=/

# SSH private keys + password store live here. Never served over the API.
SECRETS_DIR=./secrets

# Fernet key encrypting passwords/passphrases in secrets/credentials.json.
# Leave blank and one is generated into secrets/.master.key on first use.
# Set it explicitly if the secrets dir is shared or backed up separately --
# losing the key means every stored password must be re-entered.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Model shards (head.pt / tail.pt) that /run/deploy pushes to the devices.
SHARDS_DIR=./shards

# Where agents + shards are installed on each device.
REMOTE_ROOT=/opt/split-inference

# Python interpreter to invoke on the devices.
REMOTE_PYTHON=python3

# Max concurrent SSH operations during a fan-out.
FANOUT_CONCURRENCY=8
SSH_CONNECT_TIMEOUT=10

# Caps the internal one-shot probes only (uname, agent launch, sha256sum).
# Commands you type in the Control tab are not capped by it.
SSH_COMMAND_TIMEOUT=120

# How long /control/exec waits before answering and leaving the command
# running. `ls` finishes inside this and is reported inline; `python3
# Server.py` keeps running, keeps streaming to the console, and is stopped by
# typing ^C in the same box.
EXEC_DETACH_AFTER=5

# Escape hatch: allow arbitrary shell on /control/exec (pipes, ;, &&).
# Leave false unless you own every device in the inventory.
ALLOW_UNSAFE_COMMANDS=false

# Simulation guard -- mirrors the UI's `maxMessageMb` prop (default 15).
MAX_MESSAGE_MB=15

# Rolling window (frames) used to average live metrics before broadcasting.
METRICS_WINDOW=60
METRICS_BROADCAST_HZ=2


# --------------------------------------------------------------------------
# Auto-run -- unattended schedule scripts (POST /autorun/start)
# --------------------------------------------------------------------------

# Where schedule scripts live. /autorun/start refuses to run anything outside
# this directory: the endpoint executes a shell script with this service's
# privileges, so which file runs is the whole security boundary.
AUTORUN_DIR=./autorun

# Lift that sandbox and allow any absolute path. Only for a box where every
# API-token holder is already trusted with a shell on it.
AUTORUN_ALLOW_ANY_PATH=false

# Quiet period (seconds) after which a run is REPORTED as possibly stuck. It is
# never killed for going quiet -- a training step is legitimately silent for a
# long time. 0 disables the warning.
AUTORUN_STALL_SECONDS=900

# Seconds to wait at each rung of SIGINT -> SIGTERM -> SIGKILL when stopping,
# so a project that writes its result logs on the way out gets the chance to.
AUTORUN_STOP_GRACE=15

# Cap on one run's captured transcript. Output keeps streaming to the UI after
# the cap; only the file stops growing.
AUTORUN_LOG_MAX_MB=64

# Which keys below a schedule script inherits, by prefix (comma-separated).
# pydantic-settings parses this file into the Settings object and NEVER into
# the environment, so without this a script gets none of it.
#
# An allow-list, not the whole file, on purpose: API_TOKEN and
# TELEGRAM_BOT_TOKEN have no business in an operator script's environment,
# where a stray `env` or `set -x` would print them into a transcript this
# service stores and forwards to chat.
AUTORUN_ENV_PREFIXES=FLEET_


# --------------------------------------------------------------------------
# Fleet SSH -- consumed by autorun/fleet.py, forwarded by AUTORUN_ENV_PREFIXES
# --------------------------------------------------------------------------
# The lab subnet 192.168.101.0/24 is not routed from the workstation, so every
# LAN session tunnels through dai. See run/guides/{split,PA,dmsf}.md.
#
# These live here rather than in autorun/*.sh because .env is gitignored and
# the schedule scripts are not -- that is what lets the scripts be committed to
# a public repo without publishing 13 machine logins.
FLEET_DAI_HOST=100.68.127.89
FLEET_DAI_USER=dai
FLEET_DAI_PASS=
FLEET_EDGE_PASS=
FLEET_CLOUD_PASS=
# An interpreter that has paramiko. The backend venv does not need it.
FLEET_PYTHON=d:/SplitInference/venv/Scripts/python.exe


# --------------------------------------------------------------------------
# Notifications -- Telegram
# --------------------------------------------------------------------------
# Both values are required; without them the feature is simply inert and no
# run ever fails because of it.
#
#   token   -- talk to @BotFather, /newbot, copy the token it gives you
#   chat id -- message @userinfobot, or send your bot a message and read
#              `result[0].message.chat.id` from
#              https://api.telegram.org/bot<TOKEN>/getUpdates
#
# Verify with:  POST /autorun/notify/test
#
# TELEGRAM_BOT_TOKEN is a credential. It lives here, never in git.
NOTIFY_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_TIMEOUT=10

# Forward `::note:: ...` lines from the script as Telegram messages.
NOTIFY_NOTES=true
